# Copy to .env for local runs (never commit .env — it's gitignored).
# In Railway, set these as project Variables instead.

# From Telegram @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API key for Claude vision extraction (Phase 2+)
ANTHROPIC_API_KEY=

# Optional: override the vision model (defaults to claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8
