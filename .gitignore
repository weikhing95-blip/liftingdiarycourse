# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env files (secrets: bot token + vision API key live here)
.env
.env.*
# but keep the template (no real secrets, safe to commit)
!.env.example

# Misc
.DS_Store
*.log

# Runtime scratch (generated PDFs / temp downloads should never be committed)
/tmp_pdfs/
/downloads/
